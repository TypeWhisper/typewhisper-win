<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Velopack" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/TypeWhisper.Core/TypeWhisper.Core.csproj" />
    <Compile Include="../../src/TypeWhisper.WinUI/Platform/LicenseService.cs" Link="LicenseService.cs" />
    <Compile Include="../../src/TypeWhisper.WinUI/Platform/AppDistribution.cs" Link="AppDistribution.cs" />
    <Compile Include="../../src/TypeWhisper.WinUI/Platform/AppReleaseGithubSource.cs" Link="AppReleaseGithubSource.cs" />
    <Compile Include="../../src/TypeWhisper.WinUI/Platform/WindowsClipboardTransaction.cs" Link="WindowsClipboardTransaction.cs" />
    <Compile Include="../../src/TypeWhisper.WinUI/Platform/NativeMethods.Clipboard.cs" Link="NativeMethods.Clipboard.cs" />
    <Compile Include="../../src/TypeWhisper.WinUI/LicenseText.cs" Link="LicenseText.cs" />
    <EmbeddedResource Include="../../src/TypeWhisper.WinUI/Resources/LicenseStrings.json" LogicalName="TypeWhisper.LicenseStrings.json" />
    <EmbeddedResource Include="../../src/TypeWhisper.Windows.StorePackage/StoreProducts.json" LogicalName="TypeWhisper.StoreProducts.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The app files compiled into these tests rely on the app's project-wide import. -->
    <Using Include="TypeWhisper.Core" />
  </ItemGroup>
</Project>
