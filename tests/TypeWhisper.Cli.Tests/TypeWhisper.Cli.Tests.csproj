<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <ProjectReference Include="../../src/TypeWhisper.Cli/TypeWhisper.Cli.csproj" />
  </ItemGroup>
  <Target Name="CopyCliRuntime" AfterTargets="Build">
    <Copy SourceFiles="../../src/TypeWhisper.Cli/bin/$(Configuration)/net10.0/TypeWhisper.Cli.runtimeconfig.json;../../src/TypeWhisper.Cli/bin/$(Configuration)/net10.0/TypeWhisper.Cli.deps.json" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
