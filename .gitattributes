# Store text with LF in the repository and check it out with the platform's
# native line endings. This matches the existing index, which is LF-only.
* text=auto

# Shell scripts must keep LF, even in a Windows working tree.
*.sh text eol=lf

# Batch files need CRLF to run reliably with cmd.exe.
*.cmd text eol=crlf
*.bat text eol=crlf

