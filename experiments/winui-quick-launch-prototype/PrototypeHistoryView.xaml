<UserControl
    x:Class="TypeWhisper.WinUIPrototype.PrototypeHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TypeWhisper.WinUIPrototype">
    <UserControl.Resources>
        <Style x:Key="DeviceFlyoutPresenterStyle" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="FlyoutPresenter">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="12,0,12,12" MinHeight="32" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PageTitle" Text="History" FontSize="20" FontWeight="SemiBold"
                VerticalAlignment="Center" />
            <TextBlock x:Name="ResultSummary" Grid.Column="1" Foreground="{ThemeResource MutedBrush}"
                FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Right"
                TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
        </Grid>
        <Grid x:Name="ListPage" Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="8,0,8,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <local:HandCursorButton x:Name="AllFilter" Content="All" Tag="all" Click="Kind_Click" AutomationProperties.Name="Filter history all" />
                    <local:HandCursorButton x:Name="DictationFilter" Content="Dictations" Tag="Dictation" Click="Kind_Click" AutomationProperties.Name="Filter history dictations" />
                    <local:HandCursorButton x:Name="RecordingFilter" Content="Recordings" Tag="Recording" Click="Kind_Click" AutomationProperties.Name="Filter history recordings" />
                </StackPanel>
                <local:HandCursorButton x:Name="DeviceFilter" Grid.Column="1" MinWidth="146" MaxWidth="230"
                    Style="{StaticResource PrototypeSecondaryButtonStyle}" AutomationProperties.Name="Choose history device">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
                        <local:TypeWhisperGlyph x:Name="DeviceFilterIcon" Kind="devices" Width="18" Height="18" />
                        <TextBlock x:Name="DeviceFilterLabel" Grid.Column="1" Text="All devices" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:TypeWhisperGlyph Grid.Column="2" Kind="chevron-down" Width="12" Height="12" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout Opening="Devices_Opening" Opened="Devices_Opened" Placement="BottomEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource DeviceFlyoutPresenterStyle}">
                            <StackPanel Width="272" Spacing="6" PreviewKeyDown="Devices_PreviewKeyDown">
                                <TextBlock Text="FILTER BY DEVICE" FontSize="10" CharacterSpacing="70" Foreground="{ThemeResource MutedBrush}" Margin="12,8,12,6" />
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
                                    <StackPanel x:Name="DeviceChoices" Spacing="3" />
                                </ScrollViewer>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </local:HandCursorButton>
            </Grid>
            <local:HandCursorListView x:Name="Entries" Grid.Row="1" ItemsSource="{x:Bind FilteredEntries}"
                IsItemClickEnabled="True" ItemClick="Entry_Click" SelectionMode="Single"
                ItemContainerStyle="{StaticResource PrototypeCommandItemStyle}"
                AutomationProperties.Name="History transcripts" TabNavigation="Once">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PrototypeTranscript">
                        <Grid Padding="12,12" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Title}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:TypeWhisperGlyph Kind="{x:Bind IconKind}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Preview}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Metadata}" FontSize="10" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Time}" FontSize="11" Margin="8,2,0,0"
                                Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Top" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </local:HandCursorListView>
            <StackPanel x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center"
                HorizontalAlignment="Center" Spacing="10">
                <local:TypeWhisperGlyph Kind="search" Width="28" Height="28" />
                <TextBlock Text="No matching entries" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Try another search or reset the filters." FontSize="13" Foreground="{ThemeResource MutedBrush}" />
                <local:HandCursorButton Content="Reset filters" Click="ClearSearch_Click" HorizontalAlignment="Center"
                    Style="{StaticResource PrototypeSecondaryButtonStyle}" AutomationProperties.Name="Clear history search" />
            </StackPanel>
        </Grid>
        <Grid x:Name="ReadingPage" Grid.Row="1" Visibility="Collapsed" Margin="12,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16" Spacing="7">
                <TextBlock x:Name="TranscriptTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="TranscriptMetadata" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="AudioAvailabilityText" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                <Border Height="1" Background="{ThemeResource HairlineBrush}" Margin="0,8,0,0" />
            </StackPanel>
            <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="TranscriptBody" FontSize="15" LineHeight="25" TextWrapping="Wrap"
                    IsTextSelectionEnabled="True" Margin="0,0,20,16" AutomationProperties.Name="Transcript text" />
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0">
            <Grid Height="48" Padding="2,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:PrototypeBreadcrumbs x:Name="HistoryBreadcrumbs" VerticalAlignment="Center" />
                <TextBlock x:Name="HistoryNavigationHint" Grid.Column="1" FontSize="10" Foreground="{ThemeResource MutedBrush}"
                    VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="⌫ / Esc Back   ↑↓ Navigate   Enter Open" />
                <local:HandCursorButton x:Name="CopyButton" Grid.Column="2" Content="Copy text" Visibility="Collapsed"
                    VerticalAlignment="Center" Click="Copy_Click" Style="{StaticResource PrototypePrimaryButtonStyle}"
                    AutomationProperties.Name="Copy transcript text" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
