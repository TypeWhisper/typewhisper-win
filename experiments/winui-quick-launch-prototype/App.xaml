<Application
    x:Class="TypeWhisper.WinUIPrototype.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="InkColor">#FF0B1018</Color>
                    <Color x:Key="SurfaceColor">#FF111923</Color>
                    <Color x:Key="ElevatedColor">#FF182433</Color>
                    <Color x:Key="AccentColor">#FF3BA7FF</Color>
                    <Color x:Key="FocusColor">#FF75C4FF</Color>
                    <Color x:Key="TextColor">#FFF4F7FA</Color>
                    <Color x:Key="MutedColor">#FF93A4B8</Color>
                    <Color x:Key="HairlineColor">#FF273548</Color>
                    <SolidColorBrush x:Key="InkBrush" Color="#FF0B1018" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF111923" />
                    <SolidColorBrush x:Key="ElevatedBrush" Color="#FF182433" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#FF3BA7FF" />
                    <SolidColorBrush x:Key="FocusBrush" Color="#FF75C4FF" />
                    <SolidColorBrush x:Key="TextBrush" Color="#FFF4F7FA" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#FFA7B5C5" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#FF273548" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="InkColor">#FFF3F6FA</Color>
                    <Color x:Key="SurfaceColor">#FFF8FAFC</Color>
                    <Color x:Key="ElevatedColor">#FFFFFFFF</Color>
                    <Color x:Key="AccentColor">#FF0878D1</Color>
                    <Color x:Key="FocusColor">#FF005EA8</Color>
                    <Color x:Key="TextColor">#FF101820</Color>
                    <Color x:Key="MutedColor">#FF526577</Color>
                    <Color x:Key="HairlineColor">#FFD5DEE8</Color>
                    <SolidColorBrush x:Key="InkBrush" Color="#FFF3F6FA" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF8FAFC" />
                    <SolidColorBrush x:Key="ElevatedBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#FF0878D1" />
                    <SolidColorBrush x:Key="FocusBrush" Color="#FF005EA8" />
                    <SolidColorBrush x:Key="TextBrush" Color="#FF101820" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#FF526577" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#FFD5DEE8" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="InterfaceFont">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
            </Style>

            <Style x:Key="PrototypeSearchTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="10,0,4,0" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="ContentElement"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              HorizontalScrollMode="Auto"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollMode="Disabled"
                                              VerticalScrollBarVisibility="Hidden"
                                              ZoomMode="Disabled"
                                              IsTabStop="False"
                                              AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrototypeHeatmapToolTipStyle" TargetType="ToolTip">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{ThemeResource ElevatedBrush}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9">
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PrototypeRangeFlyoutStyle" TargetType="FlyoutPresenter">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="FlyoutPresenter">
                            <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PrototypeLexiconMultilineStyle" TargetType="TextBox" BasedOn="{StaticResource PrototypeSearchTextBoxStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="ContentElement" Margin="{TemplateBinding Padding}"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollMode="Disabled" VerticalScrollMode="Auto"
                                              VerticalContentAlignment="Top" IsTabStop="False" ZoomMode="Disabled"
                                              AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrototypeButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="ButtonVisual">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="StateOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonVisual"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="StateOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.09" Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="StateOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.17" Duration="0:0:0.04" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonVisual"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.42" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <Grid>
                                        <Border x:Name="StateOverlay" Opacity="0"
                                                Background="White"
                                                CornerRadius="{TemplateBinding CornerRadius}" />
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Padding="{TemplateBinding Padding}"
                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrototypeSourceToggleStyle" TargetType="ToggleButton">
                <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="ToggleRoot">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters><Setter Target="ToggleHover.Opacity" Value="0.09" /></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters><Setter Target="ToggleHover.Opacity" Value="0.17" /></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters><Setter Target="ToggleRoot.Opacity" Value="0.45" /></VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="7">
                                    <Grid>
                                        <Border x:Name="ToggleHover" Background="White" Opacity="0" CornerRadius="7" />
                                        <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrototypePrimaryButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource PrototypeButtonStyle}">
                <Setter Property="Background" Value="#FF12304A" />
                <Setter Property="BorderBrush" Value="#FF2F83BD" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#FFF1F8FD" />
            </Style>

            <Style x:Key="PrototypeSecondaryButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource PrototypeButtonStyle}">
                <Setter Property="Background" Value="#0FFFFFFF" />
                <Setter Property="BorderBrush" Value="#FF2B4054" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
            </Style>

            <Style x:Key="PrototypeDestructiveButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource PrototypeButtonStyle}">
                <Setter Property="Background" Value="#FF52212A" />
                <Setter Property="BorderBrush" Value="#FFB94355" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#FFFFE4E6" />
                <Setter Property="FocusVisualPrimaryBrush" Value="#FFFF99A6" />
            </Style>

            <Style x:Key="PrototypeDestructiveConfirmButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource PrototypeDestructiveButtonStyle}">
                <Setter Property="Background" Value="#FFB72840" />
                <Setter Property="BorderBrush" Value="#FFD64D64" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="PrototypeIconButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource PrototypeButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="PrototypeMenuButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource PrototypeButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="PrototypeCommandItemStyle" TargetType="ListViewItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="MinHeight" Value="50" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid x:Name="ItemRoot">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.04" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectionSurface"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                                                <DoubleAnimation Storyboard.TargetName="SignalRail"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectionSurface"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetName="SignalRail"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectionSurface"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="SignalRail"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ItemRoot"
                                                                 Storyboard.TargetProperty="Opacity" To="0.42" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="SelectionSurface" Opacity="0"
                                        Background="#FF13283A" CornerRadius="7" />
                                <Border x:Name="HoverSurface" Opacity="0"
                                        Background="#12FFFFFF" CornerRadius="7" />
                                <Border x:Name="SignalRail" Opacity="0"
                                        Width="2" Margin="0,9,0,9"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource AccentBrush}"
                                        CornerRadius="1" />
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
