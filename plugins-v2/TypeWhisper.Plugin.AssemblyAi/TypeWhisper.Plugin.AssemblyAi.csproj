<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <InternalsVisibleTo Include="TypeWhisper.Plugin.AssemblyAi.Portable.Tests" />
    <ProjectReference Include="../../src/TypeWhisper.PluginSDK/TypeWhisper.PluginSDK.csproj" />
    <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="StagePortablePackage" AfterTargets="Build">
    <PropertyGroup><PackageDirectory>$(MSBuildProjectDirectory)/bin/$(Configuration)/portable-host/Plugins/com.typewhisper.assemblyai/</PackageDirectory></PropertyGroup>
    <ItemGroup><PackageFile Include="$(TargetPath);$(TargetDir)$(TargetName).deps.json;$(ProjectDir)manifest.json" /></ItemGroup>
    <MakeDir Directories="$(PackageDirectory)" />
    <Copy SourceFiles="@(PackageFile)" DestinationFolder="$(PackageDirectory)" />
  </Target>
</Project>
