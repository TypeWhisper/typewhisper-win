<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RootNamespace>TypeWhisper.Plugin.ElevenLabs</RootNamespace><Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <InternalsVisibleTo Include="TypeWhisper.Plugin.ElevenLabs.Portable.Tests" />
    <ProjectReference Include="../../src/TypeWhisper.PluginSDK.Portable/TypeWhisper.PluginSDK.Portable.csproj" />
    <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="StagePortablePackage" AfterTargets="Build">
    <PropertyGroup><PackageDirectory>$(MSBuildProjectDirectory)/bin/$(Configuration)/portable-host/Plugins/com.typewhisper.elevenlabs/</PackageDirectory></PropertyGroup>
    <ItemGroup><PackageFile Include="$(TargetPath);$(TargetDir)$(TargetName).deps.json;$(ProjectDir)manifest.json" /></ItemGroup>
    <MakeDir Directories="$(PackageDirectory)" />
    <Copy SourceFiles="@(PackageFile)" DestinationFolder="$(PackageDirectory)" />
  </Target>
</Project>
