<Project DefaultTargets="Build">
  <Target Name="Build">
    <MSBuild Projects="TypeWhisper.Plugin.WhisperCpp.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;Platform" />
  </Target>
  <Import Project="../../eng/PortablePlugin.targets" />
  <Target Name="ValidateWindowsPackageHost" BeforeTargets="CopyPackage" Condition="'$(OS)' != 'Windows_NT'">
    <Error Text="Build distributable Whisper packages on Windows so the required Visual C++ runtime DLLs can be included. Non-Windows builds support headless tests only." />
  </Target>
  <Target Name="GetTargetFrameworks" />
  <Target Name="GetTargetPath" />
</Project>
