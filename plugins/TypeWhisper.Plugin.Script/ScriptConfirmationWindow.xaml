<Window x:Class="TypeWhisper.Plugin.Script.ScriptConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:ClassModifier="internal"
        Width="500"
        Height="220"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown"
        Background="{DynamicResource ScriptWindowBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="0" CornerRadius="8" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TypeWhisper.Plugin.Script;component/ScriptTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource ScriptWindowBrush}"
            BorderBrush="{StaticResource ScriptBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
            </Grid.RowDefinitions>
            <Grid Margin="20,0,12,0" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Content="&#x2715;"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="OnCancel"
                        Style="{StaticResource ScriptSecondaryButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
            <Border Grid.Row="1"
                    BorderBrush="{StaticResource ScriptBorderBrush}"
                    BorderThickness="0,1,0,1"
                    Padding="22,18">
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource ScriptMutedTextBrush}"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel x:Name="ActionFooter"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="18,0">
                <Button x:Name="CancelButton"
                        Click="OnCancel"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Style="{StaticResource ScriptSecondaryButtonStyle}" />
                <Button x:Name="SecondaryButton"
                        Click="OnSecondary"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Style="{StaticResource ScriptDangerButtonStyle}" />
                <Button x:Name="PrimaryButton"
                        IsDefault="True"
                        Click="OnPrimary"
                        MinWidth="92"
                        Style="{StaticResource ScriptPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
