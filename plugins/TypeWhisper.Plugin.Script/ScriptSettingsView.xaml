<UserControl x:Class="TypeWhisper.Plugin.Script.ScriptSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="480"
             Background="{DynamicResource ScriptWindowBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TypeWhisper.Plugin.Script;component/ScriptTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,4,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="PageTitle" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="PageSubtitle"
                           Margin="0,4,24,0"
                           Foreground="{StaticResource ScriptMutedTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="AddButton"
                    Grid.Column="1"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource ScriptPrimaryButtonStyle}" />
        </Grid>

        <StackPanel Grid.Row="1">
            <Border Padding="10"
                    Margin="0,0,0,10"
                    Background="#332C1111"
                    BorderBrush="{StaticResource ScriptDangerBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="{Binding HasLoadError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding LoadErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource ScriptErrorBrush}" />
            </Border>
            <Border Padding="10"
                    Margin="0,0,0,10"
                    Background="#332C1111"
                    BorderBrush="{StaticResource ScriptDangerBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="{Binding HasOperationError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding OperationError}" TextWrapping="Wrap" Foreground="{StaticResource ScriptErrorBrush}" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Border x:Name="EmptyStatePanel"
                    Padding="28"
                    VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ScriptCardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" MaxWidth="390">
                    <TextBlock x:Name="EmptyTitle" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock x:Name="EmptyHint"
                               Margin="0,8,0,18"
                               Foreground="{StaticResource ScriptMutedTextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Button x:Name="EmptyAddButton"
                            Command="{Binding AddCommand}"
                            HorizontalAlignment="Center"
                            Style="{StaticResource ScriptPrimaryButtonStyle}" />
                </StackPanel>
            </Border>

            <Grid x:Name="ListPanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="EditButton" Command="{Binding EditCommand}" Margin="0,0,7,0" Style="{StaticResource ScriptSecondaryButtonStyle}" />
                    <Button x:Name="RemoveButton" Command="{Binding RemoveCommand}" Margin="0,0,7,0" Style="{StaticResource ScriptDangerButtonStyle}" />
                    <Button x:Name="MoveUpButton" Command="{Binding MoveUpCommand}" Margin="0,0,7,0" Style="{StaticResource ScriptSecondaryButtonStyle}" />
                    <Button x:Name="MoveDownButton" Command="{Binding MoveDownCommand}" Style="{StaticResource ScriptSecondaryButtonStyle}" />
                </StackPanel>

                <ListBox x:Name="ScriptList"
                         Grid.Row="1"
                         MaxHeight="330"
                         AllowDrop="True"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Items}"
                         ItemContainerStyle="{StaticResource ScriptListItemStyle}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="OnScriptDoubleClick"
                         PreviewMouseLeftButtonDown="OnScriptListMouseDown"
                         PreviewMouseMove="OnScriptListMouseMove"
                         DragOver="OnScriptListDragOver"
                         DragLeave="OnScriptListDragLeave"
                         Drop="OnScriptListDrop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="12,9">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource ScriptBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                <Setter Property="Background" Value="#2A3645" />
                                                <Setter Property="BorderBrush" Value="#64778D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#x22EE;&#x22EE;"
                                               Foreground="{StaticResource ScriptMutedTextBrush}"
                                               Cursor="SizeAll"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Name}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,11,0" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CommandPreview}"
                                                   Margin="0,3,0,0"
                                                   Foreground="{StaticResource ScriptMutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Style="{StaticResource ScriptBadgeStyle}" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Shell}" FontSize="11" />
                                    </Border>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding TimeoutText}"
                                               Foreground="{StaticResource ScriptMutedTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <Button Grid.Column="5"
                                            Content="{Binding DataContext.EditLabel, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ScriptSecondaryButtonStyle}" />
                                    <Border Grid.ColumnSpan="6"
                                            Height="3"
                                            Margin="-8,-11,-8,0"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource ScriptAccentHoverBrush}"
                                            CornerRadius="2"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding ShowDropBefore, Converter={StaticResource BooleanToVisibility}}" />
                                    <Border Grid.ColumnSpan="6"
                                            Height="3"
                                            Margin="-8,0,-8,-11"
                                            VerticalAlignment="Bottom"
                                            Background="{StaticResource ScriptAccentHoverBrush}"
                                            CornerRadius="2"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding ShowDropAfter, Converter={StaticResource BooleanToVisibility}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
