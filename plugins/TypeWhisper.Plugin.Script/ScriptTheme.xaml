<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ScriptWindowBrush" Color="#0E151F" />
    <SolidColorBrush x:Key="ScriptCardBrush" Color="#151F2C" />
    <SolidColorBrush x:Key="ScriptFieldBrush" Color="#192534" />
    <SolidColorBrush x:Key="ScriptBorderBrush" Color="#2B3A4D" />
    <SolidColorBrush x:Key="ScriptTextBrush" Color="#F2F5F8" />
    <SolidColorBrush x:Key="ScriptMutedTextBrush" Color="#9BA9B9" />
    <SolidColorBrush x:Key="ScriptAccentBrush" Color="#2878E8" />
    <SolidColorBrush x:Key="ScriptAccentHoverBrush" Color="#3989F9" />
    <SolidColorBrush x:Key="ScriptDangerBrush" Color="#C94747" />
    <SolidColorBrush x:Key="ScriptErrorBrush" Color="#FF7979" />

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ScriptTextBrush}" />
    </Style>

    <Style x:Key="ScriptButtonBaseStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ScriptTextBrush}" />
        <Setter Property="Background" Value="{StaticResource ScriptFieldBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ScriptBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.42" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ScriptAccentHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScriptPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ScriptButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource ScriptAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ScriptAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ScriptSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ScriptButtonBaseStyle}" />

    <Style x:Key="ScriptDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ScriptButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource ScriptDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ScriptDangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ScriptCompactTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource ScriptTextBrush}" />
        <Setter Property="Background" Value="{StaticResource ScriptFieldBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ScriptBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource ScriptTextBrush}" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style x:Key="ScriptCompactComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource ScriptTextBrush}" />
        <Setter Property="Background" Value="{StaticResource ScriptFieldBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ScriptBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource ScriptTextBrush}" />
                    <Setter Property="Background" Value="{StaticResource ScriptFieldBrush}" />
                    <Setter Property="Padding" Value="10,7" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBorder"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#274568" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ScriptAccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="SelectionBorder"
                                Background="{StaticResource ScriptFieldBrush}"
                                BorderBrush="{StaticResource ScriptBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <ContentPresenter Margin="10,0,38,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                <Path x:Name="DropDownArrow"
                                      Width="8"
                                      Height="5"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      IsHitTestVisible="False"
                                      Fill="{StaticResource ScriptMutedTextBrush}"
                                      Data="M 0 0 L 4 4 L 8 0 Z" />
                                <ToggleButton x:Name="DropDownToggle"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="220"
                                    Margin="0,3,0,0"
                                    Background="{StaticResource ScriptFieldBrush}"
                                    BorderBrush="{StaticResource ScriptBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="DropDownToggle" Property="IsMouseOver" Value="True">
                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource ScriptAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource ScriptAccentHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScriptCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ScriptCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ScriptBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
    </Style>

    <Style x:Key="ScriptListItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#253A52" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScriptBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#22344A" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
</ResourceDictionary>
