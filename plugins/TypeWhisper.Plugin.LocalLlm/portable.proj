<Project DefaultTargets="Build">
  <Target Name="Build">
    <!-- Restore in its own evaluation so the build imports restored package props, including the llama.cpp runtimes. -->
    <MSBuild Projects="TypeWhisper.Plugin.LocalLlm.csproj" Targets="Restore" Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;Platform" />
    <MSBuild Projects="TypeWhisper.Plugin.LocalLlm.csproj" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;Platform" />
  </Target>
  <Import Project="../../eng/PortablePlugin.targets" />
  <Target Name="GetTargetFrameworks" />
  <Target Name="GetTargetPath" />
</Project>
