<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Version>1.2.5</Version><CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <Compile Include="../shared/PluginLocalization.cs" Link="Shared/PluginLocalization.cs" />
    <Compile Include="../shared/PortableLocalization.cs" Link="Shared/PortableLocalization.cs" />
    <Using Include="TypeWhisper.Plugin.Shared" />
    <InternalsVisibleTo Include="TypeWhisper.Plugin.CohereTranscribe.Portable.Tests" />
    <ProjectReference Include="../../src/TypeWhisper.PluginSDK/TypeWhisper.PluginSDK.csproj" />

    <Content Include="manifest.json;Localization/*.json;Scripts/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="StagePortablePackage" AfterTargets="Build">
    <PropertyGroup><PackageDirectory>$(MSBuildProjectDirectory)/bin/$(Configuration)/portable-host/Plugins/com.typewhisper.cohere-transcribe/</PackageDirectory></PropertyGroup>
    <!-- crispasr.exe needs the Visual C++ runtime, which its release archives do not ship. The plugin copies these files next to it. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../eng/Copy-MsvcRuntime.ps1&quot; -OutputDirectory &quot;$(TargetDir).&quot; -RuntimeIdentifiers win-x64 -Required" Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT'" />
    <ItemGroup>
      <PackageFile Include="$(TargetPath);$(TargetDir)$(TargetName).deps.json;$(ProjectDir)manifest.json" />
      <PackageDependency Include="$(TargetDir)*.dll" Exclude="$(TargetPath);$(TargetDir)TypeWhisper.PluginSDK.dll" />
      <PackageTree Include="$(TargetDir)**/*" Exclude="$(TargetDir)*;$(TargetDir)**/*.pdb;$(TargetDir)**/*.xml" />
    </ItemGroup>
    <MakeDir Directories="$(PackageDirectory)" />
    <Copy SourceFiles="@(PackageFile);@(PackageDependency)" DestinationFolder="$(PackageDirectory)" />
    <Copy SourceFiles="@(PackageTree)" DestinationFiles="@(PackageTree->'$(PackageDirectory)%(RecursiveDir)%(Filename)%(Extension)')" Condition="'@(PackageTree)' != ''" />
    <Error Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT' and (!Exists('$(PackageDirectory)runtimes/win-x64/msvcp140.dll') or !Exists('$(PackageDirectory)runtimes/win-x64/vcruntime140.dll') or !Exists('$(PackageDirectory)runtimes/win-x64/vcruntime140_1.dll') or !Exists('$(PackageDirectory)runtimes/win-x64/VCOMP140.DLL'))" Text="The Visual C++ runtime files for CrispASR are missing." />
  </Target>
</Project>
