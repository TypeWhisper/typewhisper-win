<Project DefaultTargets="Build">
  <Target Name="Build"><MSBuild Projects="TypeWhisper.Plugin.GitHubCopilot.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;Platform" /></Target>
  <Import Project="../../eng/PortablePlugin.targets" />
  <Target Name="Package" DependsOnTargets="Build">
    <PropertyGroup>
      <PackageSource>$(MSBuildProjectDirectory)/bin/$(Configuration)/portable-host/Plugins/com.typewhisper.github-copilot</PackageSource>
      <Archive>$(MSBuildProjectDirectory)/bin/$(Configuration)/com.typewhisper.github-copilot-1.1.0.zip</Archive>
    </PropertyGroup>
    <ZipDirectory SourceDirectory="$(PackageSource)" DestinationFile="$(Archive)" Overwrite="true" />
    <GetFileHash Files="$(Archive)" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="HashedArchive" /></GetFileHash>
    <WriteLinesToFile File="$(Archive).sha256" Lines="@(HashedArchive->'%(FileHash)')" Overwrite="true" />
  </Target>
  <Target Name="GetTargetFrameworks" /><Target Name="GetTargetPath" />
</Project>
