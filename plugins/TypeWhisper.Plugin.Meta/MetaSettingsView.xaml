<UserControl x:Class="TypeWhisper.Plugin.Meta.MetaSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,4" MaxWidth="500">
        <TextBlock x:Name="ApiKeyLabel" FontWeight="SemiBold" Margin="0,0,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnPasswordChanged" />
            <Button x:Name="TestButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="12,4"
                    Click="OnTestClick" />
        </Grid>
        <TextBlock x:Name="ApiKeyHintText"
                   Margin="0,4,0,0"
                   FontSize="11"
                   Foreground="Gray"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="StatusText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" />

        <StackPanel x:Name="ModelsSection" Margin="0,16,0,0" Visibility="Collapsed">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TranscriptionModelLabel" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Padding="12,4"
                        Click="OnRefreshClick" />
            </Grid>
            <ComboBox x:Name="TranscriptionModelPicker"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="OnTranscriptionModelChanged" />
            <TextBlock x:Name="TranscriptionModelHintText"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap" />

            <CheckBox x:Name="SpeakerDiarizationToggle"
                      Margin="0,16,0,0"
                      Checked="OnSpeakerDiarizationChanged"
                      Unchecked="OnSpeakerDiarizationChanged" />
            <TextBlock x:Name="SpeakerDiarizationHintText"
                       Margin="20,4,0,0"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="LlmModelLabel" FontWeight="SemiBold" Margin="0,16,0,4" />
            <ComboBox x:Name="LlmModelPicker"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="OnLlmModelChanged" />
            <TextBlock x:Name="LlmModelHintText"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="ReasoningEffortLabel" FontWeight="SemiBold" Margin="0,16,0,4" />
            <ComboBox x:Name="ReasoningEffortPicker"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Value"
                      SelectionChanged="OnReasoningEffortChanged" />
            <TextBlock x:Name="ReasoningEffortHintText"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
