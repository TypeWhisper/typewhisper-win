<UserControl x:Class="TypeWhisper.Plugin.ElevenLabs.ElevenLabsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,4" MaxWidth="500">
        <TextBlock x:Name="ApiKeyLabel" FontWeight="SemiBold" Margin="0,0,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="ApiKeyBox"
                         PasswordChanged="OnPasswordChanged"
                         AutomationProperties.AutomationId="ElevenLabsApiKey"
                         AutomationProperties.LabeledBy="{Binding ElementName=ApiKeyLabel}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,4"
                    Click="OnTestClick"
                    x:Name="TestButton"
                    AutomationProperties.AutomationId="ElevenLabsTestApiKey" />
        </Grid>
        <TextBlock x:Name="ApiKeyHintText" Margin="0,4,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
        <TextBlock x:Name="StatusText" Margin="0,6,0,0" FontSize="12" />

        <StackPanel x:Name="ConfigurationSection" Margin="0,16,0,0">
            <TextBlock x:Name="TranscriptionModelLabel" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox x:Name="TranscriptionModelPicker"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="OnTranscriptionModelChanged"
                      AutomationProperties.AutomationId="ElevenLabsTranscriptionModel"
                      AutomationProperties.LabeledBy="{Binding ElementName=TranscriptionModelLabel}" />
            <TextBlock x:Name="ModelHintText" Margin="0,4,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />

            <TextBlock x:Name="TranscriptionModeLabel" FontWeight="SemiBold" Margin="0,16,0,4" />
            <ComboBox x:Name="TranscriptionModePicker"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="OnTranscriptionModeChanged"
                      AutomationProperties.AutomationId="ElevenLabsTranscriptionMode"
                      AutomationProperties.LabeledBy="{Binding ElementName=TranscriptionModeLabel}" />
            <TextBlock x:Name="TranscriptionModeHintText"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap" />

            <CheckBox x:Name="TagAudioEventsCheckBox"
                      Margin="0,16,0,0"
                      Checked="OnTagAudioEventsChanged"
                      Unchecked="OnTagAudioEventsChanged"
                      AutomationProperties.AutomationId="ElevenLabsTagAudioEvents" />

            <CheckBox x:Name="NoVerbatimCheckBox"
                      Margin="0,10,0,0"
                      Checked="OnNoVerbatimChanged"
                      Unchecked="OnNoVerbatimChanged"
                      AutomationProperties.AutomationId="ElevenLabsNoVerbatim" />
            <TextBlock x:Name="TranscriptCleanupHintText"
                       Margin="20,4,0,0"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="SpeakerCountLabel" FontWeight="SemiBold" Margin="0,16,0,4" />
            <ComboBox x:Name="SpeakerCountPicker"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="OnSpeakerCountChanged"
                      AutomationProperties.AutomationId="ElevenLabsSpeakerCount"
                      AutomationProperties.LabeledBy="{Binding ElementName=SpeakerCountLabel}" />
            <TextBlock x:Name="RestOnlyOptionsHintText"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap" />

            <CheckBox x:Name="UseDictionaryTermsCheckBox"
                      Margin="0,16,0,0"
                      Checked="OnUseDictionaryTermsChanged"
                      Unchecked="OnUseDictionaryTermsChanged"
                      AutomationProperties.AutomationId="ElevenLabsUseDictionaryTerms" />
            <TextBlock x:Name="DictionaryTermsHintText"
                       Margin="20,4,0,0"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
