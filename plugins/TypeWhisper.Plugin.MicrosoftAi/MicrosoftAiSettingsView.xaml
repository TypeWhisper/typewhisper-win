<UserControl x:Class="TypeWhisper.Plugin.MicrosoftAi.MicrosoftAiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,4" MaxWidth="520">
        <TextBlock x:Name="ConnectionLabel" FontWeight="SemiBold" Margin="0,0,0,8" />

        <TextBlock x:Name="EndpointLabel" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="EndpointBox"
                 TextChanged="OnEndpointTextChanged"
                 AutomationProperties.AutomationId="MicrosoftAiEndpoint"
                 AutomationProperties.LabeledBy="{Binding ElementName=EndpointLabel}" />
        <TextBlock x:Name="EndpointHintText"
                   Margin="0,4,0,0"
                   FontSize="11"
                   Foreground="Gray"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="RegionWarningText"
                   Margin="0,6,0,0"
                   FontSize="11"
                   Foreground="DarkOrange"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <TextBlock x:Name="ApiKeyLabel" FontWeight="SemiBold" Margin="0,16,0,4" />
        <PasswordBox x:Name="ApiKeyBox"
                     MaxLength="512"
                     AutomationProperties.AutomationId="MicrosoftAiApiKey"
                     AutomationProperties.LabeledBy="{Binding ElementName=ApiKeyLabel}" />
        <TextBlock x:Name="ApiKeyHintText"
                   Margin="0,4,0,0"
                   FontSize="11"
                   Foreground="Gray"
                   TextWrapping="Wrap" />
        <Button x:Name="SaveButton"
                Margin="0,10,0,0"
                Padding="12,4"
                HorizontalAlignment="Left"
                Click="OnSaveClick"
                AutomationProperties.AutomationId="MicrosoftAiSaveConnection" />
        <TextBlock x:Name="StatusText" Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap" />

        <Grid Margin="0,20,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ModelLabel" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    x:Name="RefreshModelsButton"
                    Padding="12,4"
                    Click="OnRefreshModelsClick"
                    AutomationProperties.AutomationId="MicrosoftAiRefreshModels" />
        </Grid>
        <ComboBox x:Name="ModelPicker"
                  DisplayMemberPath="DisplayName"
                  SelectionChanged="OnModelChanged"
                  AutomationProperties.AutomationId="MicrosoftAiModel"
                  AutomationProperties.LabeledBy="{Binding ElementName=ModelLabel}" />
        <TextBlock x:Name="ModelHintText"
                   Margin="0,4,0,0"
                   FontSize="11"
                   Foreground="Gray"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="TranscriptStyleLabel" FontWeight="SemiBold" Margin="0,16,0,4" />
        <ComboBox x:Name="TranscriptStylePicker"
                  DisplayMemberPath="DisplayName"
                  SelectionChanged="OnTranscriptStyleChanged"
                  AutomationProperties.AutomationId="MicrosoftAiTranscriptStyle"
                  AutomationProperties.LabeledBy="{Binding ElementName=TranscriptStyleLabel}" />
        <TextBlock x:Name="TranscriptStyleHintText"
                   Margin="0,4,0,0"
                   FontSize="11"
                   Foreground="Gray"
                   TextWrapping="Wrap" />

        <CheckBox x:Name="SpeakerDiarizationCheckBox"
                  Margin="0,16,0,0"
                  Checked="OnSpeakerDiarizationChanged"
                  Unchecked="OnSpeakerDiarizationChanged"
                  AutomationProperties.AutomationId="MicrosoftAiSpeakerDiarization" />
        <TextBlock x:Name="DiarizationHintText"
                   Margin="20,4,0,0"
                   FontSize="11"
                   Foreground="Gray"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
