<Project Sdk="Microsoft.NET.Sdk">
  <!-- Nemotron 3 Diarization through ONNX Runtime, the way a .NET app would ship it.
       The DirectML build of ONNX Runtime; its newest release is older than the CPU package the app pins.
       The sources are shared with the other build in ../NemotronOnnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);ORT_DIRECTML</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <Compile Include="../NemotronOnnx/*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
