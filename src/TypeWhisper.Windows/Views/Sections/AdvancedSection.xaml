<UserControl x:Class="TypeWhisper.Windows.Views.Sections.AdvancedSection"
             AutomationProperties.AutomationId="SettingsSection.Advanced"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:TypeWhisper.Windows.Converters"
             xmlns:loc="clr-namespace:TypeWhisper.Windows.Services.Localization">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/UnifiedSettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28" MaxWidth="980">
            <StackPanel Style="{StaticResource SettingsSectionStyle}">
                <TextBlock Text="{loc:Str Advanced.MemorySection}" Style="{StaticResource SettingsGroupTitleStyle}"/>
                <Border Style="{StaticResource SettingsGroupPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Str Advanced.EnableMemory}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                <ui:ToggleSwitch Grid.Column="1"
                                                 AutomationProperties.AutomationId="AdvancedMemory"
                                                 AutomationProperties.Name="{loc:Str Advanced.EnableMemory}"
                                                 IsChecked="{Binding Settings.MemoryEnabled, Mode=TwoWay, FallbackValue=False}"
                                                 OnContent=""
                                                 OffContent=""/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#18FFFFFF"/>

                        <Border Grid.Row="2" Style="{StaticResource SettingsRowBorderStyle}">
                            <TextBlock Text="{loc:Str Advanced.MemoryHint}"
                                       Style="{StaticResource HintStyle}"
                                       FontSize="12"
                                       Margin="0"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Style="{StaticResource SettingsSectionStyle}">
                <TextBlock Text="{loc:Str SpokenFormatting.Title}" Style="{StaticResource SettingsGroupTitleStyle}"/>
                <Border Style="{StaticResource SettingsGroupPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Str SpokenFormatting.ModelContext}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                    <TextBlock Text="{loc:Str SpokenFormatting.ModelContextHint}" Style="{StaticResource HintStyle}" Margin="0,4,18,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SpokenFormatting.CurrentEngineDisplayName}"
                                               Style="{StaticResource SettingsCompactValueTextStyle}"
                                               AutomationProperties.AutomationId="SpokenFormattingEngine"/>
                                    <TextBlock Text="{Binding SpokenFormatting.CurrentModelDisplayName}"
                                               Style="{StaticResource HintStyle}"
                                               TextAlignment="Right"
                                               Margin="0,4,0,0"
                                               AutomationProperties.AutomationId="SpokenFormattingModel"/>
                                    <TextBlock Text="{loc:Str SpokenFormatting.NoModelHint}"
                                               Style="{StaticResource HintStyle}"
                                               TextAlignment="Right"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding SpokenFormatting.HasNoSelectedModel, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#18FFFFFF"/>

                        <Border Grid.Row="2" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Str SpokenFormatting.ProfileLanguage}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          Width="220"
                                          AutomationProperties.AutomationId="SpokenFormattingLanguage"
                                          AutomationProperties.Name="{loc:Str SpokenFormatting.ProfileLanguage}"
                                          Style="{StaticResource SettingsAlignedComboBoxStyle}"
                                          ItemsSource="{Binding SpokenFormatting.AvailableLanguages}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Code"
                                          SelectedValue="{Binding SpokenFormatting.SelectedLanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="#18FFFFFF"/>

                        <Border Grid.Row="4" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Str SpokenFormatting.Strategy}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                    <TextBlock Text="{loc:Str SpokenFormatting.StrategyHint}" Style="{StaticResource HintStyle}" Margin="0,4,18,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Width="220"
                                          AutomationProperties.AutomationId="SpokenFormattingStrategy"
                                          AutomationProperties.Name="{loc:Str SpokenFormatting.Strategy}"
                                          Style="{StaticResource SettingsAlignedComboBoxStyle}"
                                          ItemsSource="{Binding SpokenFormatting.AvailableStrategies}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SpokenFormatting.SelectedStrategy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding SpokenFormatting.HasSelectedModel}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="5" Background="#18FFFFFF"/>

                        <Border Grid.Row="6" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Str SpokenFormatting.VerificationStatus}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SpokenFormatting.VerificationStatusText}"
                                           Style="{StaticResource SettingsCompactValueTextStyle}"
                                           AutomationProperties.AutomationId="SpokenFormattingVerificationStatus"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="7" Background="#18FFFFFF"/>

                        <Border Grid.Row="8" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Str SpokenFormatting.TestHint}" Style="{StaticResource HintStyle}" TextWrapping="Wrap" Margin="0,0,18,0"/>
                                <Button Grid.Column="1"
                                        Content="{loc:Str SpokenFormatting.TestButton}"
                                        AutomationProperties.AutomationId="SpokenFormattingTest"
                                        AutomationProperties.Name="{loc:Str SpokenFormatting.TestButton}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="{Binding SpokenFormatting.HasSelectedModel}"
                                        Click="OnTestSpokenFormattingClick"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Style="{StaticResource SettingsSectionStyle}">
                <TextBlock Text="{loc:Str Recording.Title}" Style="{StaticResource SettingsGroupTitleStyle}"/>
                <Border Style="{StaticResource SettingsGroupPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Str Advanced.AutoUnloadModel}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          AutomationProperties.AutomationId="AdvancedAutoUnloadModel"
                                          AutomationProperties.Name="{loc:Str Advanced.AutoUnloadModel}"
                                          Style="{StaticResource SettingsAlignedComboBoxStyle}"
                                          SelectedValue="{Binding Settings.AutoUnloadMinutes, FallbackValue=0}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="{loc:Str Advanced.AutoUnloadNever}" Tag="0"/>
                                    <ComboBoxItem Content="{loc:Str Advanced.AutoUnload5}" Tag="5"/>
                                    <ComboBoxItem Content="{loc:Str Advanced.AutoUnload15}" Tag="15"/>
                                    <ComboBoxItem Content="{loc:Str Advanced.AutoUnload30}" Tag="30"/>
                                    <ComboBoxItem Content="{loc:Str Advanced.AutoUnload60}" Tag="60"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#18FFFFFF"/>

                        <Border Grid.Row="2" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Str Advanced.SpokenFeedback}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                <ui:ToggleSwitch Grid.Column="1"
                                                 AutomationProperties.AutomationId="AdvancedSpokenFeedback"
                                                 AutomationProperties.Name="{loc:Str Advanced.SpokenFeedback}"
                                                 IsChecked="{Binding Settings.SpokenFeedbackEnabled, Mode=TwoWay, FallbackValue=False}"
                                                 OnContent=""
                                                 OffContent=""/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="#18FFFFFF"/>

                        <Border Grid.Row="4"
                                Style="{StaticResource SettingsRowBorderStyle}"
                                Visibility="{Binding Settings.SpokenFeedbackEnabled, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Str Advanced.SpokenFeedbackProvider}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          AutomationProperties.AutomationId="AdvancedSpokenFeedbackProvider"
                                          AutomationProperties.Name="{loc:Str Advanced.SpokenFeedbackProvider}"
                                          Style="{StaticResource SettingsAlignedComboBoxStyle}"
                                          ItemsSource="{Binding Settings.SpokenFeedbackProviders}"
                                          SelectedValue="{Binding Settings.SelectedSpokenFeedbackProviderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="5"
                                Background="#18FFFFFF"
                                Visibility="{Binding Settings.SpokenFeedbackEnabled, Converter={StaticResource BoolToVis}}"/>

                        <Border Grid.Row="6"
                                Style="{StaticResource SettingsRowBorderStyle}"
                                Visibility="{Binding Settings.SpokenFeedbackEnabled, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Str Advanced.SpokenFeedbackVoice}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          AutomationProperties.AutomationId="AdvancedSpokenFeedbackVoice"
                                          AutomationProperties.Name="{loc:Str Advanced.SpokenFeedbackVoice}"
                                          Style="{StaticResource SettingsAlignedComboBoxStyle}"
                                          ItemsSource="{Binding Settings.SpokenFeedbackVoices}"
                                          SelectedValue="{Binding Settings.SelectedSpokenFeedbackVoiceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="7"
                                Background="#18FFFFFF"
                                Visibility="{Binding Settings.SpokenFeedbackEnabled, Converter={StaticResource BoolToVis}}"/>

                        <Border Grid.Row="8" Style="{StaticResource SettingsRowBorderStyle}">
                            <TextBlock Text="{loc:Str Advanced.RecordingHint}"
                                       Style="{StaticResource HintStyle}"
                                       FontSize="12"
                                       Margin="0"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Style="{StaticResource SettingsSectionStyle}">
                <TextBlock Text="{loc:Str Advanced.DataSection}" Style="{StaticResource SettingsGroupTitleStyle}"/>
                <Border Style="{StaticResource SettingsGroupPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Str Advanced.SaveToHistory}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                <ui:ToggleSwitch Grid.Column="1"
                                                 AutomationProperties.AutomationId="AdvancedSaveToHistory"
                                                 AutomationProperties.Name="{loc:Str Advanced.SaveToHistory}"
                                                 IsChecked="{Binding Settings.SaveToHistoryEnabled, Mode=TwoWay, FallbackValue=True}"
                                                 OnContent=""
                                                 OffContent=""/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#18FFFFFF"/>

                        <Border Grid.Row="2" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Str Advanced.HistoryRetention}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          AutomationProperties.AutomationId="AdvancedHistoryRetention"
                                          AutomationProperties.Name="{loc:Str Advanced.HistoryRetention}"
                                          Style="{StaticResource SettingsAlignedComboBoxStyle}"
                                          ItemsSource="{Binding Settings.HistoryRetentionOptions}"
                                          SelectedItem="{Binding Settings.SelectedHistoryRetentionOption}"
                                          DisplayMemberPath="DisplayName"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="#18FFFFFF"/>

                        <Border Grid.Row="4" Style="{StaticResource SettingsRowBorderStyle}">
                            <TextBlock Text="{loc:Str Advanced.DataHint}"
                                       Style="{StaticResource HintStyle}"
                                       FontSize="12"
                                       Margin="0"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Style="{StaticResource SettingsSectionStyle}">
                <TextBlock Text="{loc:Str Backup.SectionTitle}" Style="{StaticResource SettingsGroupTitleStyle}"/>
                <Border Style="{StaticResource SettingsGroupPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="{loc:Str Backup.ExportActionTitle}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                    <TextBlock Text="{loc:Str Backup.ExportActionHint}"
                                               Style="{StaticResource HintStyle}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{loc:Str Backup.ExportButton}"
                                        AutomationProperties.AutomationId="AdvancedExportBackup"
                                        AutomationProperties.Name="{loc:Str Backup.ExportButton}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnExportBackupClick"
                                        Padding="14,8"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#18FFFFFF"/>

                        <Border Grid.Row="2" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="{loc:Str Backup.RestoreActionTitle}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                    <TextBlock Text="{loc:Str Backup.RestoreActionHint}"
                                               Style="{StaticResource HintStyle}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{loc:Str Backup.RestoreButton}"
                                        AutomationProperties.AutomationId="AdvancedRestoreBackup"
                                        AutomationProperties.Name="{loc:Str Backup.RestoreButton}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="OnRestoreBackupClick"
                                        Padding="14,8"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="#18FFFFFF"/>

                        <Border Grid.Row="4" Style="{StaticResource SettingsRowBorderStyle}">
                            <TextBlock Text="{loc:Str Backup.SectionHint}"
                                       Style="{StaticResource HintStyle}"
                                       FontSize="12"
                                       Margin="0"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Style="{StaticResource SettingsSectionStyle}">
                <TextBlock Text="{loc:Str Advanced.ApiSection}" Style="{StaticResource SettingsGroupTitleStyle}"/>
                <Border Style="{StaticResource SettingsGroupPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Str Advanced.ApiEnable}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                <ui:ToggleSwitch Grid.Column="1"
                                                 AutomationProperties.AutomationId="AdvancedApiEnabled"
                                                 AutomationProperties.Name="{loc:Str Advanced.ApiEnable}"
                                                 IsChecked="{Binding Settings.ApiServerEnabled, Mode=TwoWay}"
                                                 OnContent=""
                                                 OffContent=""/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#18FFFFFF"/>

                        <Border Grid.Row="2" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Str Advanced.ApiPort}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                <TextBox Grid.Column="1"
                                         AutomationProperties.AutomationId="AdvancedApiPort"
                                         AutomationProperties.Name="{loc:Str Advanced.ApiPort}"
                                         Text="{Binding Settings.ApiServerPort, Mode=TwoWay}"
                                         Style="{StaticResource SettingsNumericTextBoxStyle}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="#18FFFFFF"/>

                        <Border Grid.Row="4" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Str Advanced.ApiRequireToken}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                    <TextBlock Text="{loc:Str Advanced.ApiRequireTokenHint}"
                                               Style="{StaticResource HintStyle}"
                                               FontSize="12"
                                               Margin="0,4,16,0"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1"
                                                 AutomationProperties.AutomationId="AdvancedApiRequireToken"
                                                 AutomationProperties.Name="{loc:Str Advanced.ApiRequireToken}"
                                                 IsChecked="{Binding Settings.ApiServerRequiresAuthentication, Mode=TwoWay}"
                                                 OnContent=""
                                                 OffContent=""/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="5" Background="#18FFFFFF"/>

                        <Border Grid.Row="6" Style="{StaticResource SettingsRowBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding Settings.ApiServerStatusText}"
                                           Style="{StaticResource SettingsRowLabelStyle}"/>
                                <TextBlock Text="{Binding Settings.ApiServerErrorText}"
                                           Style="{StaticResource HintStyle}"
                                           Foreground="#FF6B6B"
                                           FontSize="12"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="7" Background="#18FFFFFF"/>

                        <Border Grid.Row="8" Style="{StaticResource SettingsRowBorderStyle}">
                            <TextBlock Text="{loc:Str Advanced.ApiHint}"
                                       Style="{StaticResource HintStyle}"
                                       FontSize="12"
                                       Margin="0"/>
                        </Border>

                        <Border Grid.Row="9" Background="#18FFFFFF"/>

                        <Border Grid.Row="10" Style="{StaticResource SettingsRowBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Str Advanced.CurlExamples}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                <ItemsControl ItemsSource="{Binding Settings.CurlExamples}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Command}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           Foreground="{StaticResource HintBrush}"
                                                           TextWrapping="Wrap"/>
                                                <Button Grid.Column="1"
                                                        AutomationProperties.AutomationId="{Binding Key, StringFormat=AdvancedCopyApiExample.{0}}"
                                                        Content="{loc:Str Advanced.Copy}"
                                                        Margin="12,0,0,0"
                                                        Padding="10,4"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.Settings.CopyCommandExampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Command}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Style="{StaticResource SettingsSectionStyle}">
                <TextBlock Text="{loc:Str Advanced.CliSection}" Style="{StaticResource SettingsGroupTitleStyle}"/>
                <Border Style="{StaticResource SettingsGroupPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Settings.CliStatusText}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                    <TextBlock Text="{Binding Settings.CliBundledPathText}"
                                               Style="{StaticResource HintStyle}"
                                               FontSize="12"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{loc:Str Advanced.Refresh}"
                                            AutomationProperties.AutomationId="AdvancedRefreshCli"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding Settings.RefreshCliStateCommand}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="{loc:Str Advanced.InstallCli}"
                                            AutomationProperties.AutomationId="AdvancedInstallCli"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            IsEnabled="{Binding Settings.CliBundledAvailable}"
                                            Command="{Binding Settings.InstallCliCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#18FFFFFF"/>

                        <Border Grid.Row="2" Style="{StaticResource SettingsRowBorderStyle}">
                            <TextBlock Text="{loc:Str Advanced.CliHint}"
                                       Style="{StaticResource HintStyle}"
                                       FontSize="12"
                                       Margin="0"/>
                        </Border>

                        <Border Grid.Row="3" Background="#18FFFFFF"/>

                        <Border Grid.Row="4" Style="{StaticResource SettingsRowBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Str Advanced.CliExamples}" Style="{StaticResource SettingsRowLabelStyle}"/>
                                <ItemsControl ItemsSource="{Binding Settings.CliExamples}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Command}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           Foreground="{StaticResource HintBrush}"
                                                           TextWrapping="Wrap"/>
                                                <Button Grid.Column="1"
                                                        AutomationProperties.AutomationId="{Binding Key, StringFormat=AdvancedCopyCliExample.{0}}"
                                                        Content="{loc:Str Advanced.Copy}"
                                                        Margin="12,0,0,0"
                                                        Padding="10,4"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.Settings.CopyCommandExampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Command}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
