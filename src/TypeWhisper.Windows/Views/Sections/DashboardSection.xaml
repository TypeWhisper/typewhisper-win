<UserControl x:Class="TypeWhisper.Windows.Views.Sections.DashboardSection"
             AutomationProperties.AutomationId="SettingsSection.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TypeWhisper.Windows.Converters"
             xmlns:controls="clr-namespace:TypeWhisper.Windows.Controls"
             xmlns:loc="clr-namespace:TypeWhisper.Windows.Services.Localization"
             xmlns:vm="clr-namespace:TypeWhisper.Windows.ViewModels">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/UnifiedSettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:InvertBoolConverter x:Key="InvertBoolConverter"/>
            <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="DashboardNavigationTileStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="Height" Value="132"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Tile"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource CardAltBrush}"/>
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="#660078D4"/>
                                    <Setter TargetName="Tile" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="-2"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource SecondaryPressedBrush}"/>
                                    <Setter TargetName="Tile" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                                    <Setter TargetName="Tile" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="980" Margin="28">

            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="{loc:Str Dashboard.Title}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{loc:Str Dashboard.Subtitle}"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Statistics is the single source of truth for usage data. -->
            <Border Style="{StaticResource SettingsHeroCardStyle}"
                    Padding="22"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Str Dashboard.Statistics}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Str Statistics.Subtitle}"
                                   Style="{StaticResource PageSubtitleStyle}"
                                   MaxWidth="520"
                                   HorizontalAlignment="Left"
                                   Margin="0,7,0,16"/>
                        <Button Content="{loc:Str Dashboard.OpenStatistics}"
                                AutomationProperties.AutomationId="DashboardOpenStatistics"
                                Command="{Binding NavigateToRouteCommand}"
                                CommandParameter="{x:Static vm:SettingsRoute.Statistics}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="14,7"/>
                    </StackPanel>

                    <!-- A quiet speech waveform makes the destination recognizable without showing stale metrics. -->
                    <Border Grid.Column="1"
                            Width="176"
                            Height="92"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#141D29"
                            BorderBrush="#33476A8E"
                            BorderThickness="1"
                            CornerRadius="46">
                        <controls:WaveformLogo Width="112"
                                               Height="76"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               AutomationProperties.Name="TypeWhisper"/>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="{loc:Str Dashboard.QuickAccess}"
                       Style="{StaticResource SettingsGroupTitleStyle}"
                       Margin="0,0,0,12"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0"
                        Margin="0,0,7,14"
                        Style="{StaticResource DashboardNavigationTileStyle}"
                        AutomationProperties.AutomationId="DashboardOpenDictation"
                        Command="{Binding NavigateToRouteCommand}"
                        CommandParameter="{x:Static vm:SettingsRoute.Dictation}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="20" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Foreground="{StaticResource HintBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="{loc:Str Nav.Dictation}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Str Page.DictationSubtitle}"
                                       Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Row="0" Grid.Column="1"
                        Margin="7,0,0,14"
                        Style="{StaticResource DashboardNavigationTileStyle}"
                        AutomationProperties.AutomationId="DashboardOpenShortcuts"
                        Command="{Binding NavigateToRouteCommand}"
                        CommandParameter="{x:Static vm:SettingsRoute.Shortcuts}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="20" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Foreground="{StaticResource HintBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="{loc:Str Nav.Shortcuts}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Str Page.ShortcutsSubtitle}"
                                       Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Row="1" Grid.Column="0"
                        Margin="0,0,7,0"
                        Style="{StaticResource DashboardNavigationTileStyle}"
                        AutomationProperties.AutomationId="DashboardOpenHistory"
                        Command="{Binding NavigateToRouteCommand}"
                        CommandParameter="{x:Static vm:SettingsRoute.History}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="20" Foreground="{StaticResource ActiveIndicatorBrush}"/>
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Foreground="{StaticResource HintBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="{loc:Str Nav.History}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Str Page.HistorySubtitle}"
                                       Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Row="1" Grid.Column="1"
                        Margin="7,0,0,0"
                        Style="{StaticResource DashboardNavigationTileStyle}"
                        AutomationProperties.AutomationId="DashboardOpenWorkflows"
                        Command="{Binding NavigateToRouteCommand}"
                        CommandParameter="{x:Static vm:SettingsRoute.Workflows}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="20" Foreground="{StaticResource ActiveIndicatorBrush}"/>
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Foreground="{StaticResource HintBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="{loc:Str Nav.Workflows}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Str Page.WorkflowsSubtitle}"
                                       Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <!-- Development seed tools stay available without dominating the real dashboard. -->
            <Border Style="{StaticResource SettingsActionBarStyle}"
                    Margin="0,22,0,0"
                    Visibility="{Binding IsDevelopmentBuild, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="{loc:Str Dashboard.ClearAndSeed}"
                            AutomationProperties.AutomationId="DashboardClearAndSeed"
                            Command="{Binding ClearAndSeedDevelopmentDataCommand}"
                            IsEnabled="{Binding IsDevelopmentSeeding, Converter={StaticResource InvertBoolConverter}}"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="12,6"
                            VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Str Dashboard.DevSeedTitle}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{loc:Str Dashboard.DevSeedDescription}"
                                   Foreground="{StaticResource HintBrush}"
                                   FontSize="11.5"
                                   Margin="0,3,18,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DevelopmentSeedStatusText}"
                                   FontSize="11.5"
                                   Margin="0,7,18,0"
                                   Visibility="{Binding DevelopmentSeedStatusText, Converter={StaticResource NonEmptyToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDevelopmentSeedFailure}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
