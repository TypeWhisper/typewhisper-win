<Window
    x:Class="TypeWhisper.WinUI.TranscriptPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TypeWhisper.WinUI"
    Title="TypeWhisper Live Transcript">

    <Border x:Name="TranscriptRoot"
            Background="{ThemeResource SurfaceBrush}"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="14,14,0,0"
            Padding="18,11,18,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <local:DragHandleGrid x:Name="TranscriptHeader" Background="Transparent" MinHeight="28"
                  CornerRadius="6" Padding="5,2" Margin="-5,0,-5,0"
                  PointerEntered="TranscriptHeader_PointerEntered"
                  PointerExited="TranscriptHeader_PointerExited"
                  PointerPressed="TranscriptHeader_PointerPressed"
                  PointerMoved="TranscriptHeader_PointerMoved"
                  PointerReleased="TranscriptHeader_PointerReleased"
                  PointerCaptureLost="TranscriptHeader_PointerCaptureLost"
                  AutomationProperties.Name="Live text window drag handle">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock x:Name="DragHint" Text="⠿" FontSize="16" Foreground="{ThemeResource MutedBrush}" Visibility="Collapsed" />
                    <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="LIVE TRANSCRIPT" FontSize="9" FontWeight="SemiBold"
                               CharacterSpacing="70" Foreground="{ThemeResource AccentBrush}" />
                </StackPanel>
                <TextBlock x:Name="TranscriptSourceLabel" Grid.Column="1" Text="DEMO TEXT" FontFamily="Cascadia Mono"
                           FontSize="8" Foreground="{ThemeResource MutedBrush}" />
            </local:DragHandleGrid>

            <ScrollViewer Padding="{StaticResource VerticalScrollGutter}" x:Name="TranscriptScrollViewer"
                          Grid.Row="1"
                          Margin="0,7,0,0"
                          VerticalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          ViewChanged="TranscriptScrollViewer_ViewChanged"
                          AutomationProperties.Name="Live transcript text">
                <TextBlock x:Name="TranscriptText"
                           Margin="0"
                           FontSize="13"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextBrush}" />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
