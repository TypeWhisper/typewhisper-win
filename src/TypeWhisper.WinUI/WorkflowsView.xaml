<UserControl
    x:Class="TypeWhisper.WinUI.WorkflowsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TypeWhisper.WinUI"
    PreviewKeyDown="Shortcut_PreviewKeyDown" KeyUp="Shortcut_PreviewKeyUp">
    <UserControl.Resources>
        <Style x:Key="WorkflowEditorStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
            <Setter Property="SelectionHighlightColor" Value="{ThemeResource AccentBrush}" />
            <Setter Property="Background" Value="{ThemeResource InkBrush}" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="12,9,12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters><Setter Target="EditorBorder.BorderBrush" Value="{ThemeResource HairlineBrush}" /></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters><Setter Target="EditorBorder.BorderBrush" Value="{ThemeResource AccentBrush}" /></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters><Setter Target="EditorBorder.Opacity" Value="0.45" /></VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="EditorBorder" Background="{TemplateBinding Background}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" CornerRadius="8">
                                <ScrollViewer x:Name="ContentElement" Margin="{TemplateBinding Padding}" VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Top" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled" IsTabStop="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A row spans the list card; its corners and its line to the row above are set per container. -->
        <Style x:Key="WorkflowRowStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusBrush}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="RowRoot">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Selected" />
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="RowHover.Opacity" Value="0.09" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="RowHover.Opacity" Value="0.09" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="RowHover.Opacity" Value="0.17" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="RowHover.Opacity" Value="0.17" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="RowRoot.Opacity" Value="0.42" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="RowHover" Opacity="0" Background="{ThemeResource StateOverlayBrush}" CornerRadius="{TemplateBinding CornerRadius}" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid PreviewKeyDown="Configuration_PreviewKeyDown">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="12,0,12,14" MinHeight="32" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="WorkflowPageTitle" Text="Workflows" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="WorkflowSummary" Grid.Column="1" Text="Workflows" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </Grid>
        <Border x:Name="WorkflowSearchHost" Grid.Row="1" Margin="12,0,12,14" />
        <Grid x:Name="WorkflowListPage" Grid.Row="2" Margin="12,0,12,0">
            <Border x:Name="WorkflowListCard" VerticalAlignment="Top" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" CornerRadius="12">
                <ListView x:Name="WorkflowList" ItemsSource="{x:Bind FilteredWorkflows}" ItemContainerStyle="{StaticResource WorkflowRowStyle}"
                    FontFamily="{StaticResource InterfaceFont}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Workflow_Click" TabNavigation="Once" AutomationProperties.Name="Saved workflows">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:WorkflowDraft">
                            <Grid Padding="18,8,12,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Title}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <local:TypeWhisperGlyph Kind="{x:Bind IconKind}" Width="20" Height="20" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" Tag="{x:Bind}" IsOn="{x:Bind IsEnabled}" Loaded="RowToggle_Loaded" Toggled="RowToggle_Toggled" />
                                <local:HandCursorButton Grid.Column="3" Tag="{x:Bind}" Click="RowDelete_Click" Loaded="RowDelete_Loaded" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0"
                                    Style="{StaticResource IconButtonStyle}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </local:HandCursorButton>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
            <StackPanel x:Name="WorkflowEmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                <local:TypeWhisperGlyph Kind="workflow" Width="28" Height="28" />
                <TextBlock x:Name="WorkflowEmptyTitle" Text="No workflows found" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <local:HandCursorButton x:Name="WorkflowEmptyAction" Content="Clear search" Click="ClearSearch_Click" Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Center" AutomationProperties.Name="Clear workflow search" />
            </StackPanel>
        </Grid>
        <Grid x:Name="WorkflowConfigurationPage" Grid.Row="2" Margin="12,0,0,0" Visibility="Collapsed">
            <ScrollViewer x:Name="ConfigurationScroll" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ConfigurationFields" Spacing="20" Margin="0,0,0,12" />
            </ScrollViewer>
        </Grid>
        <Border x:Name="ConfigurationDiscardPrompt" Grid.Row="2" Visibility="Collapsed" Margin="24" Padding="22"
            Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" CornerRadius="12"
            VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <TextBlock x:Name="ConfigurationDiscardTitle" Text="Discard your changes?" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="ConfigurationDiscardDescription" Text="The saved workflow will stay unchanged." FontSize="13"
                    Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <local:HandCursorButton x:Name="KeepWorkflowEditing" Content="Keep editing" Click="KeepEditing_Click"
                        Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Keep workflow changes" />
                    <local:HandCursorButton x:Name="DiscardWorkflowChanges" Content="Discard changes" Click="DiscardConfiguration_Click"
                        Style="{StaticResource DestructiveConfirmButtonStyle}" AutomationProperties.Name="Discard workflow changes" />
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock x:Name="ConfigurationValidation" Grid.Row="3" Margin="12,8,12,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
            Foreground="{ThemeResource MutedBrush}" AutomationProperties.LiveSetting="Polite" />
        <Border x:Name="ContextActionsFooter" Grid.Row="4" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0" Margin="12,10,12,0">
            <StackPanel MinHeight="52" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <local:HandCursorButton x:Name="DefaultLlmButton" Content="Default LLM" Click="DefaultLlm_Click" VerticalAlignment="Center"
                    Style="{StaticResource SecondaryButtonStyle}" />
                <local:HandCursorButton x:Name="TestWorkflowButton" Content="Test workflow…" Click="TestWorkflow_Click" Visibility="Collapsed" VerticalAlignment="Center"
                    Style="{StaticResource SecondaryButtonStyle}" />
                <local:HandCursorButton x:Name="CancelConfigurationButton" Content="Cancel" Click="CancelConfiguration_Click" Visibility="Collapsed" VerticalAlignment="Center"
                    Style="{StaticResource SecondaryButtonStyle}" />
                <local:HandCursorButton x:Name="NewWorkflowButton" Content="+  New workflow" Click="NewWorkflow_Click" VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Create new workflow" />
                <local:HandCursorButton x:Name="WorkflowPrimaryButton" Content="Save changes" Click="Primary_Click" Visibility="Collapsed"
                    Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Workflow primary action" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
