<UserControl
    x:Class="TypeWhisper.WinUI.PrototypePluginsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TypeWhisper.WinUI">
    <Grid PreviewKeyDown="View_PreviewKeyDown">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="12,0,12,12" MinHeight="32" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="PluginPageTitle" Text="Plugins" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PluginSummary" Grid.Column="1" Text="4 plugins · sample data" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="PluginListPage" Grid.Row="1" RowSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0">
                <local:HandCursorButton x:Name="AllFilter" Content="All" Tag="all" Click="Filter_Click" Style="{StaticResource PrototypePrimaryButtonStyle}" AutomationProperties.Name="All plugins" />
                <local:HandCursorButton x:Name="EnabledFilter" Content="Enabled" Tag="enabled" Click="Filter_Click" Style="{StaticResource PrototypeIconButtonStyle}" AutomationProperties.Name="Enabled plugins" />
                <local:HandCursorButton x:Name="AttentionFilter" Content="Needs attention" Tag="attention" Click="Filter_Click" Style="{StaticResource PrototypeIconButtonStyle}" AutomationProperties.Name="Plugins needing attention" />
            </StackPanel>
            <local:HandCursorListView x:Name="PluginList" Grid.Row="1" ItemsSource="{x:Bind FilteredPlugins}" ItemContainerStyle="{StaticResource PrototypeCommandItemStyle}"
                SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Plugin_Click" TabNavigation="Once" AutomationProperties.Name="Sample installed plugins">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PrototypePlugin">
                        <Grid Padding="12,12" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Title}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <local:TypeWhisperGlyph Kind="{x:Bind IconKind}" Width="21" Height="21" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Category}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Status}" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </local:HandCursorListView>
            <StackPanel x:Name="PluginEmptyState" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                <local:TypeWhisperGlyph Kind="search" Width="28" Height="28" />
                <TextBlock Text="No matching plugins" FontSize="18" FontWeight="SemiBold" />
                <local:HandCursorButton Content="Reset filters" Click="Reset_Click" Style="{StaticResource PrototypeSecondaryButtonStyle}" HorizontalAlignment="Center" AutomationProperties.Name="Reset plugin filters" />
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="PluginDetailPage" Grid.Row="1" Margin="12,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="0,0,18,8">
                <TextBlock x:Name="PluginDescription" FontSize="14" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="9" Padding="14,12">
                    <StackPanel Spacing="5">
                        <TextBlock x:Name="PluginStatus" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="PluginStatusExplanation" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel Spacing="6">
                    <TextBlock Text="ACCESS" FontSize="10" CharacterSpacing="70" Foreground="{ThemeResource MutedBrush}" />
                    <TextBlock x:Name="PluginPermissions" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="PluginVersion" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Illustrative plugin only. No code is loaded and no device, network or clipboard access is performed." FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PluginSettingsPage" Grid.Row="1" Margin="12,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="0,0,18,8">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="SettingsPluginName" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Changes apply only to this example plugin and last for this prototype session." FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="ConnectionSection" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="CONNECTION" FontSize="10" CharacterSpacing="70" Foreground="{ThemeResource MutedBrush}" />
                    <local:HandCursorButton x:Name="ConnectionButton" Content="Simulate connection" Click="Connection_Click" Style="{StaticResource PrototypeSecondaryButtonStyle}" HorizontalAlignment="Left" AutomationProperties.Name="Simulate plugin connection" />
                    <TextBlock Text="Demo only: no API key is requested and no connection is made." FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock x:Name="PreferenceHeading" Text="PROCESSING PREFERENCE" FontSize="10" CharacterSpacing="70" Foreground="{ThemeResource MutedBrush}" />
                    <local:PrototypeChoicePicker x:Name="PreferencePicker" />
                </StackPanel>
                <StackPanel x:Name="LanguageSection" Spacing="7">
                    <TextBlock Text="LANGUAGE" FontSize="10" CharacterSpacing="70" Foreground="{ThemeResource MutedBrush}" />
                    <local:PrototypeChoicePicker x:Name="LanguagePicker" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="PluginDiscardPrompt" Grid.Row="1" Visibility="Collapsed" Margin="24" Padding="22" Background="{ThemeResource SurfaceBrush}"
            BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" CornerRadius="12" VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <TextBlock Text="Discard plugin changes?" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Your saved settings will stay unchanged." FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <local:HandCursorButton x:Name="KeepPluginEditing" Content="Keep editing" Click="Keep_Click" Style="{StaticResource PrototypeSecondaryButtonStyle}" AutomationProperties.Name="Keep plugin changes" />
                    <local:HandCursorButton Content="Discard changes" Click="Discard_Click" Style="{StaticResource PrototypeDestructiveConfirmButtonStyle}" AutomationProperties.Name="Discard plugin changes" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0">
            <Grid Height="48" Padding="2,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <local:PrototypeBreadcrumbs x:Name="PluginBreadcrumbs" VerticalAlignment="Center" />
                <TextBlock x:Name="PluginNavigationHint" Grid.Column="1" Text="⌫ / Esc Back   ↑↓ Navigate   Enter Open" FontSize="10" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <local:HandCursorButton x:Name="BrowseMarketplaceButton" Content="Browse marketplace" Click="Marketplace_Click" Style="{StaticResource PrototypeSecondaryButtonStyle}" AutomationProperties.Name="Browse plugin marketplace" />
                    <local:HandCursorButton x:Name="PluginToggleButton" Content="Disable" Click="Toggle_Click" Visibility="Collapsed" Style="{StaticResource PrototypeSecondaryButtonStyle}" AutomationProperties.Name="Toggle example plugin" />
                    <local:HandCursorButton x:Name="PluginPrimaryButton" Content="Settings" Click="Primary_Click" Visibility="Collapsed" Style="{StaticResource PrototypePrimaryButtonStyle}" AutomationProperties.Name="Plugin primary action" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
