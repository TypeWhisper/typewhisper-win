<Application
    x:Class="TypeWhisper.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="InkBrush" Color="#FF1C1C1E" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF2A2A2C" />
                    <SolidColorBrush x:Key="ElevatedBrush" Color="#FF333336" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF" />
                    <SolidColorBrush x:Key="FocusBrush" Color="#FF409CFF" />
                    <SolidColorBrush x:Key="TextBrush" Color="#FFF5F5F7" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#FFA1A1A6" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#FF3A3A3C" />
                    <SolidColorBrush x:Key="SelectionFillBrush" Color="#FF0A6BD6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="InkBrush" Color="#FFF2F2F7" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ElevatedBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#FF0066CC" />
                    <SolidColorBrush x:Key="FocusBrush" Color="#FF0055AA" />
                    <SolidColorBrush x:Key="TextBrush" Color="#FF1D1D1F" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#FF6E6E73" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#FFD1D1D6" />
                    <SolidColorBrush x:Key="SelectionFillBrush" Color="#FF0066CC" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Thickness x:Key="VerticalScrollGutter">0,0,20,0</Thickness>

            <FontFamily x:Key="InterfaceFont">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
            </Style>

            <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="10,0,4,0" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="ContentElement"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              HorizontalScrollMode="Auto"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollMode="Disabled"
                                              VerticalScrollBarVisibility="Hidden"
                                              ZoomMode="Disabled"
                                              IsTabStop="False"
                                              AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HeatmapToolTipStyle" TargetType="ToolTip">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{ThemeResource ElevatedBrush}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9">
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RangeFlyoutStyle" TargetType="FlyoutPresenter">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="FlyoutPresenter">
                            <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="LexiconMultilineStyle" TargetType="TextBox" BasedOn="{StaticResource SearchTextBoxStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid Background="{TemplateBinding Background}">
                                <ScrollViewer Padding="{StaticResource VerticalScrollGutter}" x:Name="ContentElement" Margin="{TemplateBinding Padding}"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollMode="Disabled" VerticalScrollMode="Auto"
                                              VerticalContentAlignment="Top" IsTabStop="False" ZoomMode="Disabled"
                                              AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="ButtonVisual">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="StateOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonVisual"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="StateOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.09" Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="StateOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.17" Duration="0:0:0.04" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonVisual"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.42" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <Grid>
                                        <Border x:Name="StateOverlay" Opacity="0"
                                                Background="White"
                                                CornerRadius="{TemplateBinding CornerRadius}" />
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Padding="{TemplateBinding Padding}"
                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SourceToggleStyle" TargetType="ToggleButton">
                <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="ToggleRoot">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters><Setter Target="ToggleHover.Opacity" Value="0.09" /></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters><Setter Target="ToggleHover.Opacity" Value="0.17" /></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters><Setter Target="ToggleRoot.Opacity" Value="0.45" /></VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="7">
                                    <Grid>
                                        <Border x:Name="ToggleHover" Background="White" Opacity="0" CornerRadius="7" />
                                        <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource ButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SelectionFillBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource ButtonStyle}">
                <Setter Property="Background" Value="#0FFFFFFF" />
                <Setter Property="BorderBrush" Value="#FF48484A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
            </Style>

            <Style x:Key="DestructiveButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource ButtonStyle}">
                <Setter Property="Background" Value="#FF52212A" />
                <Setter Property="BorderBrush" Value="#FFB94355" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#FFFFE4E6" />
                <Setter Property="FocusVisualPrimaryBrush" Value="#FFFF99A6" />
            </Style>

            <Style x:Key="DestructiveConfirmButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource DestructiveButtonStyle}">
                <Setter Property="Background" Value="#FFB72840" />
                <Setter Property="BorderBrush" Value="#FFD64D64" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource ButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="MenuButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource ButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="SidebarSelectedButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource MenuButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SelectionFillBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="CommandItemStyle" TargetType="ListViewItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="MinHeight" Value="50" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid x:Name="ItemRoot">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.04" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectionSurface"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                                                <DoubleAnimation Storyboard.TargetName="SignalRail"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectionSurface"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetName="SignalRail"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectionSurface"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="SignalRail"
                                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ItemRoot"
                                                                 Storyboard.TargetProperty="Opacity" To="0.42" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="SelectionSurface" Opacity="0"
                                        Background="#FF13283A" CornerRadius="7" />
                                <Border x:Name="HoverSurface" Opacity="0"
                                        Background="#12FFFFFF" CornerRadius="7" />
                                <Border x:Name="SignalRail" Opacity="0"
                                        Width="2" Margin="0,9,0,9"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource AccentBrush}"
                                        CornerRadius="1" />
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
