<UserControl
    x:Class="TypeWhisper.WinUI.RecorderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TypeWhisper.WinUI"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml" KeyDown="Recorder_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="8,0,8,12" Spacing="12">
            <local:TabBar x:Name="RecorderTabs" />
            <TextBlock Text="Recorder" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,0" MinHeight="32" />
        </StackPanel>
        <ScrollViewer Padding="{StaticResource VerticalScrollGutter}" x:Name="RecordingContent" Grid.Row="1" Margin="12,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="9">
                <TextBox x:Name="RecordingName" Header="Recording name (optional)" PlaceholderText="Untitled recording" MaxLength="200" TextChanged="RecordingName_Changed" AutomationProperties.Name="Recording name" />
                <Border x:Name="AudioSourceHelp" />
                <Grid x:Name="SourceChoices" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <local:HandCursorToggleButton x:Name="MicrophoneSource" Checked="Source_Changed" Unchecked="Source_Changed"
                        Style="{StaticResource SourceToggleStyle}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Recorder source microphone">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <local:TypeWhisperGlyph x:Name="MicrophoneIcon" Kind="microphone" Width="20" Height="20" />
                            <TextBlock Grid.Column="1" Text="Microphone" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="MicrophoneState" Grid.Column="2" Text="On" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </local:HandCursorToggleButton>
                    <local:HandCursorToggleButton x:Name="SystemSource" Grid.Column="1" Checked="Source_Changed" Unchecked="Source_Changed"
                        Style="{StaticResource SourceToggleStyle}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Recorder source system audio">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <local:TypeWhisperGlyph x:Name="SystemIcon" Kind="speaker" Width="20" Height="20" />
                            <TextBlock Grid.Column="1" Text="System audio" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="SystemState" Grid.Column="2" Text="Off" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </local:HandCursorToggleButton>
                </Grid>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <StackPanel x:Name="SessionPanel" VerticalAlignment="Top" Spacing="6">
                    <TextBlock x:Name="RecorderStatus" Text="Ready to record" FontSize="14" HorizontalAlignment="Center"
                        Foreground="{ThemeResource MutedBrush}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="RecorderDuration" Text="00:00" FontFamily="Cascadia Mono" FontSize="32"
                        HorizontalAlignment="Center" />
                    <canvas:CanvasControl x:Name="SignalCanvas" Draw="SignalCanvas_Draw" Height="28" MaxWidth="420"
                        HorizontalAlignment="Stretch" ClearColor="Transparent" IsHitTestVisible="False" />
                    <TextBlock x:Name="SessionHint" Text="Choose a source, then start your session." FontSize="12"
                        Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="DiscardConfirmation" Visibility="Collapsed" Background="{ThemeResource ElevatedBrush}"
                    BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" CornerRadius="10" Padding="20"
                    VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Discard recording?" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Discard is unavailable in this recorder." FontSize="12"
                            TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <local:HandCursorButton x:Name="KeepSessionButton" Content="Keep session" Click="KeepSession_Click"
                                Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Keep recorder session" />
                            <local:HandCursorButton Content="Discard session" Click="ConfirmDiscard_Click"
                                Style="{StaticResource DestructiveConfirmButtonStyle}" AutomationProperties.Name="Confirm discard recorder session" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>
        <Grid x:Name="LibraryPanel" Grid.Row="1" Margin="12,4,12,0" Padding="0,0,4,0" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <TextBlock x:Name="LibraryStatus" Text="Saved recordings" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,100,0" AutomationProperties.LiveSetting="Polite" />
                <local:HandCursorButton x:Name="LibraryRefreshButton" Content="Refresh" Click="LibraryRefresh_Click" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
            <local:HandCursorListView x:Name="LibraryEntries" Grid.Row="1" SelectionMode="Single"
                ItemContainerStyle="{StaticResource CommandItemStyle}" SelectionChanged="LibrarySelection_Changed"
                IsItemClickEnabled="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            <Border x:Name="LibraryPlaybackPanel" Grid.Row="2" Visibility="Collapsed" Padding="12" Margin="0,8,0,0"
                    Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="LibraryPlaybackTitle" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                    <MediaPlayerElement x:Name="LibraryPlayerElement" Height="80" AutoPlay="False" AreTransportControlsEnabled="True">
                        <MediaPlayerElement.TransportControls>
                            <MediaTransportControls IsCompact="True" IsZoomButtonVisible="False" IsPlaybackRateButtonVisible="False" ShowAndHideAutomatically="False" />
                        </MediaPlayerElement.TransportControls>
                    </MediaPlayerElement>
                    <local:HandCursorButton Content="Stop playback" Click="StopLibraryPlayback_Click" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0">
            <Grid Padding="2,8" ColumnSpacing="12" RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:Breadcrumbs x:Name="RecorderBreadcrumbs" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="⌫ / Esc Back" FontSize="10" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
                <StackPanel x:Name="SessionActions" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="LibraryRecordingStatus" Visibility="Collapsed" VerticalAlignment="Center" FontSize="12" MaxWidth="240" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                    <local:HandCursorButton x:Name="LibraryQueueButton" Content="Transcribe &#x00B7; T" Click="LibraryQueue_Click" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" />
                    <local:HandCursorButton x:Name="LibraryFolderButton" Content="Folder &#x00B7; F" Click="LibraryFolder_Click" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" />
                    <local:HandCursorButton x:Name="LibraryDeleteButton" Content="Delete &#x00B7; Del" Click="LibraryDelete_Click" Visibility="Collapsed" Style="{StaticResource DestructiveButtonStyle}" />
                    <local:HandCursorButton x:Name="LibraryPlayButton" Content="Play audio &#x00B7; Enter" Click="LibraryPlay_Click" Visibility="Collapsed" Style="{StaticResource PrimaryButtonStyle}" />
                    <local:HandCursorButton x:Name="OpenFolderButton" Content="Open folder" Click="OpenFolder_Click" Visibility="Collapsed" />
                    <local:HandCursorButton x:Name="ViewHistoryButton" Content="Transcribe file…" Click="ViewHistory_Click" Visibility="Collapsed"
                        Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Transcribe saved recording" />
                    <local:HandCursorButton x:Name="DiscardButton" Content="Discard" Click="Discard_Click" Visibility="Collapsed"
                        Style="{StaticResource DestructiveButtonStyle}" AutomationProperties.Name="Discard recorder session" />
                    <local:HandCursorButton x:Name="PauseButton" Content="Pause" Click="Pause_Click" Visibility="Collapsed"
                        Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Pause or resume this recording" />
                    <local:HandCursorButton x:Name="PrimaryButton" Content="Start recording" Click="Primary_Click"
                        Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Recorder primary action" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
