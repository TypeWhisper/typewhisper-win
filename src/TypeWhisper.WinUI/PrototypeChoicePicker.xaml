<UserControl x:Class="TypeWhisper.WinUI.PrototypeChoicePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TypeWhisper.WinUI">
    <UserControl.Resources>
        <Style x:Key="ChoiceFlyoutStyle" TargetType="FlyoutPresenter">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="FlyoutPresenter">
                        <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <local:HandCursorButton x:Name="ChoiceButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
        MinHeight="42" Style="{StaticResource PrototypeSecondaryButtonStyle}">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
            <local:TypeWhisperGlyph x:Name="ChoiceIcon" Width="18" Height="18" />
            <TextBlock x:Name="ChoiceLabel" Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <local:TypeWhisperGlyph Grid.Column="2" Kind="chevron-down" Width="12" Height="12" />
        </Grid>
        <Button.Flyout>
            <Flyout Opening="Choice_Opening" Opened="Choice_Opened" Closed="Choice_Closed" Placement="BottomEdgeAlignedLeft" FlyoutPresenterStyle="{StaticResource ChoiceFlyoutStyle}">
                <StackPanel Width="262" Spacing="6" PreviewKeyDown="Choices_KeyDown">
                    <TextBlock x:Name="ChoiceHeading" FontSize="10" CharacterSpacing="70" Margin="12,8,12,6" Foreground="{ThemeResource MutedBrush}" />
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
                        <StackPanel x:Name="Choices" Spacing="3" />
                    </ScrollViewer>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </local:HandCursorButton>
</UserControl>
