<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TypeWhisper.Core/TypeWhisper.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="TypeWhisper.Core" />
  </ItemGroup>
  <ItemGroup>
    <!-- The World of Warcraft add-on that Settings › Games installs into the game. -->
    <EmbeddedResource Include="../../addons/wow/TypeWhisper/*" LogicalName="WowAddOn/%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
