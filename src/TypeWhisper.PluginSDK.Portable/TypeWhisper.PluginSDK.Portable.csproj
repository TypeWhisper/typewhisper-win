<Project Sdk="Microsoft.NET.Sdk">
  <!-- Same API sources and assembly identity; a single-target host reference prevents
       NuGet from selecting the legacy WPF target during WinUI restore. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TypeWhisper.PluginSDK</AssemblyName>
    <RootNamespace>TypeWhisper.PluginSDK</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../TypeWhisper.PluginSDK/**/*.cs" Exclude="../TypeWhisper.PluginSDK/bin/**/*;../TypeWhisper.PluginSDK/obj/**/*" LinkBase="SDK" />
    <InternalsVisibleTo Include="TypeWhisper.PluginSystem.Tests" />
  </ItemGroup>
</Project>
